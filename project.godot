; Engine configuration file.
; Godot 4.x — "Overdrive Arena" (Sprint 1 MVP)
;
; Заметки по стеку (см. README):
;   * rendering_method = gl_compatibility — единственный билд работает и в
;     десктопе, и в web (Yandex Games / CrazyGames требуют WebGL2, Forward+ не подходит).
;   * Физика — встроенный GodotPhysics3D (в web-экспорте Jolt недоступен без
;     отдельной компиляции wasm-модуля; для аркадной подвески разницы нет).
;   * 60 тиков физики/сек — базовый нет-тик для будущего Colyseus-синхронизатора.

config_version=5

[application]

config/name="Overdrive Arena"
config/description="Arcade vehicular arena shooter (Rocket League x World of Tanks). Sprint 1: vehicle physics, seamless bowl arena, dynamic camera."
run/main_scene="res://src/main/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/aspect="keep"

[input]

throttle={
"deadzone": 0.2,
