{
  "name": "overdrive-server",
  "version": "0.3.0",
  "private": true,
  "description": "Colyseus authoritative server for Overdrive Arena (Sprint 3): BattleRoom, lag-compensated hit validation, FSM bots, Godot JSON relay",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p .",
    "start": "npm run build && node dist/index.js",
    "dev": "npm run build && node --watch dist/index.js",
    "test": "npm run build && node test/smoke.mjs"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.15",
    "@colyseus/schema": "^5.0.33",
    "@colyseus/ws-transport": "^0.18.3",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2"
  }
}
